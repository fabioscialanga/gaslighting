OPENAI_API_KEY=
OPENAI_AUTH_MODE=api_key

# Optional local Codex OAuth mode. Most users should keep OPENAI_AUTH_MODE=api_key.
# CODEX_OAUTH_AUTH_FILE=/path/to/.codex/auth.json
# CODEX_OAUTH_BASE_URL=https://chatgpt.com/backend-api/wham
# CODEX_OAUTH_MODEL=gpt-5.2

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# For DeepSeek V4 Pro runs, pass --models deepseek-v4-pro on the command line.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat
